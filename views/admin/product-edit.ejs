<%- include("../../views/partials/admin/header") %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs/dist/cropper.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>

<style>
.page-hero { background:linear-gradient(135deg,#0f172a 0%,#1e1b4b 100%); border-radius:16px; padding:24px 32px; color:#fff; display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; position:relative; overflow:hidden; }
.page-hero::before { content:''; position:absolute; top:-60px; right:-60px; width:180px; height:180px; background:rgba(99,102,241,0.15); border-radius:50%; }
.page-hero h1 { font-size:22px; font-weight:700; margin-bottom:4px; }
.page-hero p { color:rgba(255,255,255,0.6); font-size:13px; }

.form-layout { display:grid; grid-template-columns:1fr 360px; gap:20px; }
@media(max-width:960px){ .form-layout { grid-template-columns:1fr; } }

.form-section { background:var(--surface); border:1px solid var(--border); border-radius:14px; overflow:hidden; margin-bottom:20px; }
.form-section-header { padding:14px 20px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:10px; }
.form-section-header .sec-icon { width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:13px; flex-shrink:0; }
.form-section-header h3 { font-size:14px; font-weight:600; }
.form-section-header p { font-size:12px; color:var(--text-muted); margin-top:1px; }
.form-section-body { padding:20px; }

.field-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
@media(max-width:600px){ .field-grid { grid-template-columns:1fr; } }
.form-field { margin-bottom:0; }
.form-field.full { grid-column:1/-1; }
.form-field label { display:block; font-size:11.5px; font-weight:600; color:var(--text-secondary); margin-bottom:6px; text-transform:uppercase; letter-spacing:0.05em; }
.form-field input, .form-field select, .form-field textarea { width:100%; padding:10px 13px; border:1.5px solid var(--border); border-radius:9px; font-size:14px; font-family:'Inter',sans-serif; color:var(--text-primary); background:#fafbff; transition:all 0.2s; outline:none; }
.form-field input:focus, .form-field select:focus, .form-field textarea:focus { border-color:#6366f1; box-shadow:0 0 0 3px rgba(99,102,241,0.1); background:var(--surface); }
.field-error { color:#ef4444; font-size:11.5px; margin-top:4px; min-height:16px; }

/* Image slots */
.img-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.img-slot { border:2px dashed var(--border); border-radius:12px; overflow:hidden; position:relative; background:#fafbff; transition:all 0.2s; }
.img-slot.has-image { border-style:solid; border-color:#6366f1; }
.img-slot-inner { padding:20px 14px; display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:140px; cursor:pointer; }
.img-slot-inner:hover { background:#f5f3ff; }
.img-slot-inner i { font-size:24px; color:var(--text-muted); margin-bottom:8px; }
.img-slot-inner .slot-label { font-size:12px; font-weight:600; color:var(--text-secondary); margin-bottom:2px; }
.img-slot-inner .slot-hint { font-size:11px; color:var(--text-muted); }
.img-slot-inner input[type="file"] { position:absolute; inset:0; opacity:0; cursor:pointer; width:100%; height:100%; }
.img-num-badge { position:absolute; top:8px; left:8px; background:#6366f1; color:#fff; border-radius:6px; padding:2px 8px; font-size:11px; font-weight:600; z-index:2; }

/* Existing image */
.existing-img-wrap { position:relative; width:100%; }
.existing-img-wrap img { width:100%; height:140px; object-fit:cover; display:block; border-radius:10px; }
.delete-img-btn { position:absolute; top:8px; right:8px; background:#ef4444; color:#fff; border:none; border-radius:50%; width:26px; height:26px; display:flex; align-items:center; justify-content:center; font-size:11px; cursor:pointer; z-index:2; transition:background 0.15s; }
.delete-img-btn:hover { background:#dc2626; }
.new-img-preview { position:relative; }
.new-img-preview img { width:100%; height:140px; object-fit:contain; display:block; }
.new-img-preview .remove-btn { position:absolute; top:8px; right:8px; background:#ef4444; color:#fff; border:none; border-radius:50%; width:26px; height:26px; display:flex; align-items:center; justify-content:center; font-size:11px; cursor:pointer; }

/* Sidebar */
.sidebar-card { background:var(--surface); border:1px solid var(--border); border-radius:14px; overflow:hidden; position:sticky; top:80px; }
.sidebar-card-header { padding:14px 20px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:8px; }
.sidebar-card-header h3 { font-size:14px; font-weight:600; }
.sidebar-card-body { padding:20px; }
.update-btn { width:100%; padding:14px; background:linear-gradient(135deg,#6366f1,#8b5cf6); color:#fff; border:none; border-radius:10px; font-size:15px; font-weight:700; cursor:pointer; transition:all 0.2s; font-family:'Inter',sans-serif; display:flex; align-items:center; justify-content:center; gap:8px; }
.update-btn:hover { opacity:0.92; transform:translateY(-2px); box-shadow:0 8px 20px rgba(99,102,241,0.35); }

.img-status-row { display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; padding:8px 12px; background:#f8fafc; border-radius:8px; }
.img-status-count { font-size:13px; font-weight:600; color:var(--text-primary); }
.img-status-label { font-size:11px; color:var(--text-muted); }
</style>

<!-- Hero -->
<div class="page-hero">
    <div style="position:relative;z-index:1;">
        <h1><i class="fas fa-pencil-alt" style="margin-right:8px;opacity:0.8;"></i>Edit Product</h1>
        <p>Update the details for <strong><%= product.productName %></strong></p>
    </div>
    <a href="/admin/products" style="position:relative;z-index:1;background:rgba(255,255,255,0.1);color:#fff;padding:10px 18px;border-radius:9px;font-size:13px;font-weight:500;display:flex;align-items:center;gap:8px;text-decoration:none;border:1px solid rgba(255,255,255,0.15);">
        <i class="fas fa-arrow-left"></i> Back to Products
    </a>
</div>

<form id="editProductForm" method="POST" action="/admin/editProduct/<%= product._id %>" enctype="multipart/form-data">
<div class="form-layout">

    <!-- LEFT: form sections -->
    <div>
        <!-- Basic Info -->
        <div class="form-section">
            <div class="form-section-header">
                <div class="sec-icon" style="background:#ede9fe;color:#7c3aed;"><i class="fas fa-info-circle"></i></div>
                <div><h3>Basic Information</h3><p>Name, description, category and brand</p></div>
            </div>
            <div class="form-section-body">
                <div class="field-grid">
                    <div class="form-field full">
                        <label>Product Name <span style="color:#ef4444;">*</span></label>
                        <input type="text" name="productName" id="product_name" value="<%= product.productName %>">
                        <div id="productName-error" class="field-error"></div>
                    </div>
                    <div class="form-field">
                        <label>Brand <span style="color:#ef4444;">*</span></label>
                        <input type="text" name="brand" value="<%= product.brand %>">
                    </div>
                    <div class="form-field">
                        <label>Category <span style="color:#ef4444;">*</span></label>
                        <select name="category">
                            <% for(let i = 0; i < cat.length; i++) { %>
                                <option value="<%= cat[i]._id %>" <%= product.category.equals(cat[i]._id) ? 'selected' : '' %>><%= cat[i].name %></option>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-field full">
                        <label>Short Description <span style="color:#ef4444;">*</span></label>
                        <textarea name="description" rows="3"><%= product.description %></textarea>
                    </div>
                    <div class="form-field full">
                        <label>Full Description</label>
                        <textarea name="fullDescription" rows="4"><%= product.fullDescription %></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Specs -->
        <div class="form-section">
            <div class="form-section-header">
                <div class="sec-icon" style="background:#dbeafe;color:#1d4ed8;"><i class="fas fa-microchip"></i></div>
                <div><h3>Specifications</h3><p>Technical details and hardware specs</p></div>
            </div>
            <div class="form-section-body">
                <div class="field-grid">
                    <div class="form-field">
                        <label>Processor</label>
                        <input type="text" name="processor" value="<%= product.processor %>">
                    </div>
                    <div class="form-field">
                        <label>Graphics Card</label>
                        <input type="text" name="graphicsCard" value="<%= product.graphicsCard %>">
                    </div>
                    <div class="form-field">
                        <label>Storage</label>
                        <input type="text" name="storages" value="<%= product.storages %>">
                    </div>
                    <div class="form-field">
                        <label>Display</label>
                        <input type="text" name="display" value="<%= product.display %>">
                    </div>
                    <div class="form-field">
                        <label>Operating System</label>
                        <input type="text" name="operatingSystem" value="<%= product.operatingSystem %>">
                    </div>
                    <div class="form-field">
                        <label>Color</label>
                        <input type="text" name="color" value="<%= product.color %>">
                    </div>
                    <div class="form-field full">
                        <label>Box Contains</label>
                        <input type="text" name="boxContains" value="<%= product.boxContains %>">
                    </div>
                </div>
            </div>
        </div>

        <!-- Images -->
        <div class="form-section">
            <div class="form-section-header">
                <div class="sec-icon" style="background:#fef9c3;color:#a16207;"><i class="fas fa-images"></i></div>
                <div><h3>Product Images</h3><p>Delete existing images or upload new ones for empty slots</p></div>
            </div>
            <div class="form-section-body">
                <div class="img-grid">
                    <% for(let i = 0; i < 4; i++) { %>
                    <div class="img-slot <%= product.productImage[i] ? 'has-image' : '' %>" id="slot<%= i %>">
                        <span class="img-num-badge">Image <%= i+1 %></span>

                        <% if(product.productImage[i]) { %>
                            <!-- Existing image -->
                            <div class="existing-img-wrap" id="existingWrap<%= i %>">
                                <img src="<%= product.productImage[i].startsWith('http') ? product.productImage[i] : '/' + product.productImage[i] %>" alt="Image <%= i+1 %>">
                                <button type="button" class="delete-img-btn" onclick="deleteSingleImage('<%= product.productImage[i] %>', '<%= product._id %>', <%= i %>)" title="Delete image">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        <% } else { %>
                            <!-- Empty upload slot -->
                            <div class="img-slot-inner" id="slotInner<%= i %>">
                                <i class="fas fa-cloud-upload-alt"></i>
                                <div class="slot-label">Click to upload</div>
                                <div class="slot-hint">JPG, PNG, WebP — 5MB max</div>
                                <input type="file" name="image<%= i+1 %>" id="image<%= i %>" accept="image/*" onchange="previewNewImage(event, <%= i %>)">
                            </div>
                            <div class="new-img-preview" id="newPreview<%= i %>" style="display:none;position:relative;">
                                <img id="preview<%= i %>" src="#" alt="Preview">
                                <button type="button" class="remove-btn" onclick="clearNewImage(<%= i %>)"><i class="fas fa-times"></i></button>
                            </div>
                            <input type="hidden" name="croppedImage<%= i+1 %>" id="croppedImage<%= i+1 %>" value="">
                        <% } %>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT: sidebar -->
    <div>
        <div class="sidebar-card">
            <div class="sidebar-card-header">
                <div style="width:28px;height:28px;background:#f0fdf4;border-radius:7px;display:flex;align-items:center;justify-content:center;color:#16a34a;font-size:12px;"><i class="fas fa-tag"></i></div>
                <h3>Pricing & Stock</h3>
            </div>
            <div class="sidebar-card-body">
                <div class="form-field" style="margin-bottom:16px;">
                    <label>Regular Price (₹) <span style="color:#ef4444;">*</span></label>
                    <input type="number" name="regularPrice" id="regularPrice" step="0.01" value="<%= product.regularPrice %>">
                    <div id="regularPrice-error" class="field-error"></div>
                </div>
                <div class="form-field" style="margin-bottom:16px;">
                    <label>Sale Price (₹) <span style="color:#ef4444;">*</span></label>
                    <input type="number" name="salePrice" id="salePrice" step="0.01" value="<%= product.salePrice %>">
                    <div id="salePrice-error" class="field-error"></div>
                </div>
                <div id="discountBadge" style="display:none;background:#dcfce7;color:#16a34a;padding:8px 12px;border-radius:8px;font-size:13px;font-weight:600;margin-bottom:16px;text-align:center;"></div>
                <div class="form-field" style="margin-bottom:0;">
                    <label>Stock Quantity <span style="color:#ef4444;">*</span></label>
                    <input type="number" name="quantity" id="quantity" value="<%= product.quantity %>">
                </div>

                <div style="margin-top:20px;padding-top:20px;border-top:1px solid var(--border);">
                    <div class="img-status-row">
                        <div>
                            <div class="img-status-count" id="imgStatusCount">
                                <%= product.productImage.filter(img => img).length %> / 4 images
                            </div>
                            <div class="img-status-label">Current image slots</div>
                        </div>
                        <i class="fas fa-images" style="color:#6366f1;font-size:20px;"></i>
                    </div>

                    <div style="margin-top:8px;padding:10px 12px;background:#fef9c3;border-radius:8px;">
                        <p style="font-size:12px;color:#a16207;margin:0;"><i class="fas fa-info-circle" style="margin-right:5px;"></i>Delete an existing image first to upload a replacement in that slot.</p>
                    </div>
                </div>

                <button type="submit" class="update-btn" style="margin-top:20px;">
                    <i class="fas fa-save"></i> Save Changes
                </button>
                <a href="/admin/products" style="display:flex;align-items:center;justify-content:center;gap:6px;margin-top:10px;padding:10px;border-radius:9px;border:1px solid var(--border);color:var(--text-secondary);font-size:13px;font-weight:500;text-decoration:none;transition:all 0.2s;">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        </div>
    </div>

</div>
</form>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
let croppers = {};

function previewNewImage(event, index) {
    const input = event.target;
    const errorDiv = document.getElementById(`image${index}-error`);
    if (croppers[index]) { croppers[index].destroy(); delete croppers[index]; }

    if (input.files && input.files[0]) {
        const file = input.files[0];
        const validTypes = ['image/jpeg','image/png','image/gif','image/bmp','image/webp'];
        if (!validTypes.includes(file.type)) { if(errorDiv) errorDiv.textContent='Invalid file type'; input.value=''; return; }
        if (file.size > 5*1024*1024) { if(errorDiv) errorDiv.textContent='File must be under 5MB'; input.value=''; return; }

        const reader = new FileReader();
        reader.onload = function(e) {
            const preview = document.getElementById(`preview${index}`);
            preview.src = e.target.result;
            document.getElementById(`slotInner${index}`).style.display = 'none';
            document.getElementById(`newPreview${index}`).style.display = 'block';
            document.getElementById(`slot${index}`).classList.add('has-image');

            croppers[index] = new Cropper(preview, { aspectRatio:1, viewMode:1, autoCropArea:1, ready(){ this.cropper.crop(); } });
        };
        reader.readAsDataURL(file);
    }
}

function clearNewImage(index) {
    if (croppers[index]) { croppers[index].destroy(); delete croppers[index]; }
    document.getElementById(`preview${index}`).src = '#';
    document.getElementById(`newPreview${index}`).style.display = 'none';
    document.getElementById(`slotInner${index}`).style.display = 'flex';
    document.getElementById(`slot${index}`).classList.remove('has-image');
    document.getElementById(`image${index}`).value = '';
    document.getElementById(`croppedImage${index+1}`).value = '';
}

function deleteSingleImage(imageName, productId, index) {
    Swal.fire({
        title: 'Delete this image?',
        text: "The slot will become empty and you can upload a new image.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#e2e8f0',
        confirmButtonText: 'Yes, delete it'
    }).then((result) => {
        if (result.isConfirmed) {
            fetch('/admin/deleteImage', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ imageNameToServer: imageName, productIdToServer: productId, imageIndex: index })
            })
            .then(r => r.json())
            .then(data => {
                if (data.status) {
                    Swal.fire({ icon:'success', title:'Deleted!', text:'Image removed successfully.', timer:1500, showConfirmButton:false }).then(() => location.reload());
                } else {
                    Swal.fire('Error', 'Failed to delete image', 'error');
                }
            })
            .catch(() => Swal.fire('Error', 'An error occurred', 'error'));
        }
    });
}

// Live discount badge
function updateDiscountBadge() {
    const rp = parseFloat(document.getElementById('regularPrice').value);
    const sp = parseFloat(document.getElementById('salePrice').value);
    const badge = document.getElementById('discountBadge');
    const spErr = document.getElementById('salePrice-error');
    if (rp && sp && sp < rp) {
        const disc = Math.round((1 - sp/rp)*100);
        badge.style.display = 'block';
        badge.textContent = `💰 ${disc}% savings (₹${(rp-sp).toLocaleString()})`;
        if (spErr) spErr.textContent = '';
    } else {
        badge.style.display = 'none';
        if (sp > rp && spErr) spErr.textContent = 'Cannot exceed regular price';
        else if (spErr) spErr.textContent = '';
    }
}
document.getElementById('regularPrice').addEventListener('input', updateDiscountBadge);
document.getElementById('salePrice').addEventListener('input', updateDiscountBadge);
// Run on load
updateDiscountBadge();

document.getElementById('editProductForm').addEventListener('submit', function(e) {
    e.preventDefault();

    const qty = parseInt(document.querySelector('input[name="quantity"]').value);
    const rp  = parseFloat(document.querySelector('input[name="regularPrice"]').value);
    const sp  = parseFloat(document.querySelector('input[name="salePrice"]').value);

    if (qty < 0)  { Swal.fire({title:'Invalid Quantity',text:'Quantity cannot be negative.',icon:'error',confirmButtonColor:'#6366f1'}); return; }
    if (rp <= 0)  { Swal.fire({title:'Invalid Price',text:'Regular price must be > 0.',icon:'error',confirmButtonColor:'#6366f1'}); return; }
    if (sp <= 0)  { Swal.fire({title:'Invalid Price',text:'Sale price must be > 0.',icon:'error',confirmButtonColor:'#6366f1'}); return; }
    if (sp > rp)  { Swal.fire({title:'Invalid Price',text:'Sale price cannot exceed regular price.',icon:'error',confirmButtonColor:'#6366f1'}); return; }

    // Process cropped images
    for (let i = 0; i < 4; i++) {
        if (croppers[i]) {
            document.getElementById(`croppedImage${i+1}`).value = croppers[i].getCroppedCanvas().toDataURL('image/jpeg');
        }
    }

    const btn = document.querySelector('.update-btn');
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
    btn.disabled = true;

    fetch(this.action, { method:'POST', body: new FormData(this) })
    .then(r => r.json())
    .then(data => {
        btn.innerHTML = '<i class="fas fa-save"></i> Save Changes';
        btn.disabled = false;
        if (data.success) {
            Swal.fire({title:'Product Updated!',text:'Changes saved successfully.',icon:'success',confirmButtonColor:'#6366f1'}).then(() => { window.location.href='/admin/products'; });
        } else {
            Swal.fire({title:'Error',text:data.message||'Failed to update product.',icon:'error',confirmButtonColor:'#6366f1'});
        }
    })
    .catch(() => {
        btn.innerHTML = '<i class="fas fa-save"></i> Save Changes';
        btn.disabled = false;
        Swal.fire({title:'Error',text:'An unexpected error occurred.',icon:'error',confirmButtonColor:'#6366f1'});
    });
});
</script>

<%- include("../../views/partials/admin/footer") %>