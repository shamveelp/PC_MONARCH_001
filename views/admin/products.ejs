<%- include("../../views/partials/admin/header") %>

<style>
.page-hero { background:linear-gradient(135deg,#0f172a 0%,#1e1b4b 100%); border-radius:16px; padding:28px 32px; color:#fff; display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; position:relative; overflow:hidden; }
.page-hero::before { content:''; position:absolute; top:-60px; right:-60px; width:200px; height:200px; background:rgba(99,102,241,0.15); border-radius:50%; }
.page-hero h1 { font-size:24px; font-weight:700; margin-bottom:4px; }
.page-hero p { color:rgba(255,255,255,0.6); font-size:13px; }
.hero-stat { background:rgba(255,255,255,0.08); border-radius:10px; padding:14px 22px; text-align:center; }
.hero-stat .val { font-size:28px; font-weight:700; }
.hero-stat .lbl { font-size:11px; color:rgba(255,255,255,0.6); margin-top:2px; }

.toolbar { background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:14px 20px; margin-bottom:20px; display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; }
.table-card { background:var(--surface); border:1px solid var(--border); border-radius:14px; overflow:hidden; }
.table-card-header { padding:16px 20px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; }
.table-card-header h3 { font-size:15px; font-weight:600; }
.table-footer { padding:14px 20px; border-top:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; }

.prod-thumb { width:44px; height:44px; object-fit:cover; border-radius:8px; border:1px solid var(--border); }
.prod-name { font-weight:600; font-size:13.5px; }
.prod-brand { font-size:12px; color:var(--text-muted); }
.price-sale { font-weight:700; font-size:14px; color:#0f172a; }
.price-reg { font-size:12px; color:var(--text-muted); text-decoration:line-through; }

.ia-btn { display:inline-flex; align-items:center; gap:4px; padding:5px 11px; border-radius:7px; font-size:12px; font-weight:600; cursor:pointer; border:none; transition:all 0.15s; white-space:nowrap; }
.ia-edit { background:#ede9fe; color:#7c3aed; }
.ia-edit:hover { background:#ddd6fe; }
.ia-block { background:#fee2e2; color:#dc2626; }
.ia-block:hover { background:#fecaca; }
.ia-unblock { background:#dcfce7; color:#16a34a; }
.ia-unblock:hover { background:#bbf7d0; }
.ia-delete { background:#fff0f0; color:#dc2626; }
.ia-delete:hover { background:#fee2e2; }
.ia-offer-add { background:#f0f9ff; color:#0284c7; }
.ia-offer-add:hover { background:#e0f2fe; }
.ia-offer-edit { background:#fef9c3; color:#a16207; }
.ia-offer-edit:hover { background:#fef08a; }
.ia-offer-rm { background:#fff0f0; color:#dc2626; }

.offer-pill { background:#dcfce7; color:#16a34a; padding:3px 10px; border-radius:20px; font-size:12px; font-weight:700; display:inline-flex; align-items:center; gap:3px; }
.status-listed { background:#dcfce7; color:#16a34a; padding:4px 11px; border-radius:20px; font-size:12px; font-weight:600; }
.status-blocked { background:#fee2e2; color:#dc2626; padding:4px 11px; border-radius:20px; font-size:12px; font-weight:600; }
</style>

<!-- Hero -->
<div class="page-hero">
    <div>
        <h1>Products</h1>
        <p>Manage your complete product catalogue</p>
    </div>
    <div style="display:flex;gap:12px;position:relative;z-index:1;">
        <div class="hero-stat">
            <div class="val"><%= data.length %></div>
            <div class="lbl">Products</div>
        </div>
        <a href="/admin/addProducts" style="background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;padding:14px 22px;border-radius:10px;font-weight:600;font-size:14px;display:flex;align-items:center;gap:8px;text-decoration:none;">
            <i class="fas fa-plus"></i> Add Product
        </a>
    </div>
</div>

<!-- Toolbar -->
<div class="toolbar">
    <form action="" method="get" style="display:flex;gap:10px;align-items:center;flex:1;flex-wrap:wrap;">
        <div style="position:relative;flex:1;max-width:380px;">
            <i class="fas fa-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:13px;"></i>
            <input type="text" class="form-control" placeholder="Search products or brands..." name="search" style="padding-left:36px;">
        </div>
        <button class="btn btn-primary" type="submit"><i class="fas fa-search"></i> Search</button>
        <a href="/admin/products" class="btn btn-secondary">Reset</a>
    </form>
</div>

<!-- Products Table -->
<div class="table-card">
    <div class="table-card-header">
        <h3><i class="fas fa-box-open" style="color:#6366f1;margin-right:8px;"></i>Product Catalogue</h3>
        <span style="font-size:12px;color:var(--text-muted);background:#f1f5f9;padding:4px 12px;border-radius:20px;"><%= data.length %> products</span>
    </div>
    <div class="table-responsive">
        <table class="data-table" style="min-width:900px;">
            <thead>
                <tr>
                    <th style="padding-left:20px;">Product</th>
                    <th>Category</th>
                    <th>Pricing</th>
                    <th>Offer</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th style="text-align:right;padding-right:20px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% for(let i=data.length-1; i>=0; i--) { %>
                <tr>
                    <td style="padding-left:20px;">
                        <div style="display:flex;align-items:center;gap:12px;">
                            <% if(data[i].productImage && data[i].productImage.length > 0) { %>
                                <img src="<%= data[i].productImage[0].startsWith('http') ? data[i].productImage[0] : '/' + data[i].productImage[0] %>" class="prod-thumb" alt="<%= data[i].productName %>">
                            <% } else { %>
                                <div style="width:44px;height:44px;background:#f1f5f9;border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--text-muted);flex-shrink:0;"><i class="fas fa-image"></i></div>
                            <% } %>
                            <div>
                                <div class="prod-name"><%= data[i].productName %></div>
                                <div class="prod-brand"><%= data[i].brand %></div>
                            </div>
                        </div>
                    </td>
                    <td><span style="background:#f1f5f9;color:var(--text-secondary);padding:3px 10px;border-radius:6px;font-size:12px;font-weight:500;"><%= data[i].category ? data[i].category.name : 'N/A' %></span></td>
                    <td>
                        <div class="price-sale">₹<%= data[i].salePrice.toLocaleString() %></div>
                        <div class="price-reg">₹<%= data[i].regularPrice.toLocaleString() %></div>
                    </td>
                    <td>
                        <% if(data[i].productOffer) { %>
                            <span class="offer-pill"><i class="fas fa-bolt" style="font-size:10px;"></i><%= data[i].productOffer %>%</span>
                            <div style="display:flex;gap:4px;margin-top:6px;">
                                <button class="ia-btn ia-offer-edit" onclick="editOffer('<%= data[i]._id %>', <%= data[i].productOffer %>)">Edit</button>
                                <button class="ia-btn ia-offer-rm" onclick="removeOffer('<%= data[i]._id %>')">✕</button>
                            </div>
                        <% } else { %>
                            <button class="ia-btn ia-offer-add" onclick="addOffer('<%= data[i]._id %>')"><i class="fas fa-tag"></i> Add</button>
                        <% } %>
                    </td>
                    <td>
                        <span style="font-weight:600; color:<%= data[i].quantity < 5 ? '#dc2626' : '#0f172a' %>">
                            <%= data[i].quantity %>
                        </span>
                        <% if(data[i].quantity < 5) { %><div style="font-size:11px;color:#dc2626;">Low stock</div><% } %>
                    </td>
                    <td>
                        <% if(data[i].isBlocked) { %>
                            <span class="status-blocked">Blocked</span>
                        <% } else { %>
                            <span class="status-listed">Active</span>
                        <% } %>
                    </td>
                    <td style="padding-right:20px;">
                        <div class="ia-btn" style="display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;">
                            <a href="/admin/editProduct?id=<%= data[i]._id %>" class="ia-btn ia-edit"><i class="fas fa-pencil-alt"></i> Edit</a>
                            <% if(data[i].isBlocked === false) { %>
                                <button class="ia-btn ia-block" onclick="confirmBlockProduct(event,'<%= data[i]._id %>')"><i class="fas fa-ban"></i></button>
                            <% } else { %>
                                <button class="ia-btn ia-unblock" onclick="confirmUnblockProduct(event,'<%= data[i]._id %>')"><i class="fas fa-check"></i></button>
                            <% } %>
                            <button class="ia-btn ia-delete" onclick="confirmDelete('<%= data[i]._id %>')"><i class="fas fa-trash"></i></button>
                        </div>
                    </td>
                </tr>
                <% } %>
                <% if (data.length === 0) { %>
                <tr><td colspan="7" style="text-align:center;padding:48px;color:var(--text-muted);"><i class="fas fa-box-open" style="font-size:28px;display:block;margin-bottom:10px;opacity:0.3;"></i>No products found</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
    <div class="table-footer">
        <span style="font-size:13px;color:var(--text-muted);">Page <%= currentPage %> of <%= totalPages %></span>
        <nav>
            <ul class="pagination" style="margin:0;padding:0;">
                <% if (currentPage > 1) { %><li class="page-item"><a class="page-link" href="?page=<%= currentPage-1 %>">‹ Prev</a></li><% } else { %><li class="page-item disabled"><span class="page-link">‹ Prev</span></li><% } %>
                <% for (let i=1; i<=totalPages; i++) { %>
                    <li class="page-item <%= (i===currentPage)?'active':'' %>"><a class="page-link" href="?page=<%= i %>"><%= i %></a></li>
                <% } %>
                <% if (currentPage < totalPages) { %><li class="page-item"><a class="page-link" href="?page=<%= currentPage+1 %>">Next ›</a></li><% } else { %><li class="page-item disabled"><span class="page-link">Next ›</span></li><% } %>
            </ul>
        </nav>
    </div>
</div>

<script>
async function addOffer(productId) {
    const { value: p } = await Swal.fire({title:'Add Offer',input:'number',inputLabel:'Offer % (1–99)',inputAttributes:{min:1,max:99,step:1},showCancelButton:true,confirmButtonColor:'#6366f1',inputValidator:v=>(!v||v<1||v>99)?'Enter 1–99':null});
    if (p) updateOffer(productId, p);
}
async function editOffer(productId, cur) {
    const { value: p } = await Swal.fire({title:'Edit Offer',input:'number',inputLabel:'Offer % (1–99)',inputValue:cur,inputAttributes:{min:1,max:99,step:1},showCancelButton:true,confirmButtonColor:'#6366f1',inputValidator:v=>(!v||v<1||v>99)?'Enter 1–99':null});
    if (p) updateOffer(productId, p);
}
function updateOffer(productId, percentage) {
    $.ajax({url:'/admin/addProductOffer',method:'post',data:{productId,percentage},success:r=>{if(r.status)Swal.fire({icon:'success',timer:1500,showConfirmButton:false}).then(()=>location.reload());else Swal.fire('Error',r.message,'error');}});
}
function removeOffer(productId) {
    Swal.fire({title:'Remove Offer?',icon:'warning',showCancelButton:true,confirmButtonColor:'#ef4444'}).then(r=>{if(r.isConfirmed)$.ajax({url:'/admin/removeProductOffer',method:'post',data:{productId},success:r=>{if(r.status)Swal.fire({icon:'success',timer:1500,showConfirmButton:false}).then(()=>location.reload());else Swal.fire('Error',r.message,'error');}});});
}
function confirmBlockProduct(e,id){e.preventDefault();Swal.fire({title:'Block Product?',icon:'warning',showCancelButton:true,confirmButtonColor:'#ef4444'}).then(r=>{if(r.isConfirmed)window.location.href='/admin/blockProduct?id='+id;});}
function confirmUnblockProduct(e,id){e.preventDefault();Swal.fire({title:'Unblock Product?',icon:'info',showCancelButton:true,confirmButtonColor:'#6366f1'}).then(r=>{if(r.isConfirmed)window.location.href='/admin/unblockProduct?id='+id;});}
function confirmDelete(id){Swal.fire({title:'Delete Product?',text:'This cannot be undone.',icon:'warning',showCancelButton:true,confirmButtonColor:'#ef4444'}).then(r=>{if(r.isConfirmed)window.location.href='/admin/deleteProduct?id='+id;});}
</script>

<%- include("../../views/partials/admin/footer") %>
