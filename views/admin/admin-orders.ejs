<%- include('../partials/admin/header') %>

<div class="page-header">
    <div>
        <h1>Orders</h1>
        <p>View and manage all customer orders</p>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3>All Orders</h3>
        <span style="font-size:13px; color:var(--text-muted);">Total: <%= orders.length %></span>
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Product</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% orders.forEach(order => { %>
                <tr>
                    <td>
                        <a href="/admin/orders/<%= order._id %>" style="color:#6366f1; font-weight:600;">
                            #<%= order.orderId %>
                        </a>
                    </td>
                    <td style="color:var(--text-secondary); font-size:13px;">
                        <%= new Date(order.createdOn).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'}) %>
                    </td>
                    <td><strong><%= order.address.name %></strong></td>
                    <td>
                        <div style="display:flex;align-items:center;gap:10px;">
                            <img src="<%= order.orderedItems[0].productImages[0].startsWith('http') ? order.orderedItems[0].productImages[0] : '/' + order.orderedItems[0].productImages[0] %>"
                                 style="width:40px;height:40px;object-fit:cover;border-radius:6px;border:1px solid var(--border);">
                            <div>
                                <div style="font-weight:500; font-size:13px;"><%= order.orderedItems[0].productName %></div>
                                <div style="font-size:11px; color:var(--text-muted);">Qty: <%= order.orderedItems[0].quantity %></div>
                            </div>
                        </div>
                    </td>
                    <td><strong>₹<%= Math.round(order.finalAmount) %></strong></td>
                    <td>
                        <%
                        const badgeMap = {
                            delivered: 'badge-success',
                            cancelled: 'badge-danger',
                            shipped: 'badge-info',
                            return_requested: 'badge-warning',
                            returning: 'badge-info',
                            returned: 'badge-secondary',
                            confirmed: 'badge-purple',
                            pending: 'badge-warning'
                        };
                        const badgeClass = badgeMap[order.status] || 'badge-secondary';
                        %>
                        <span class="badge <%= badgeClass %>">
                            <%= order.status.replace('_', ' ').toUpperCase() %>
                        </span>
                    </td>
                    <td>
                        <div style="display:flex; flex-wrap:wrap; gap:6px;">
                            <a href="/admin/orders/<%= order._id %>" class="btn btn-sm btn-secondary">
                                <i class="fas fa-eye"></i> View
                            </a>
                            <% if (order.status === 'return_requested' && order.requestStatus === 'pending') { %>
                                <button onclick="handleReturn('approve', '<%= order._id %>')" class="btn btn-sm btn-success">Approve</button>
                                <button onclick="handleReturn('reject', '<%= order._id %>')" class="btn btn-sm btn-danger">Reject</button>
                            <% } else if (order.status === 'returning' && order.requestStatus === 'approved') { %>
                                <button onclick="updateReturnStatus('<%= order._id %>')" class="btn btn-sm btn-secondary">Return Status</button>
                            <% } else if (!['cancelled','delivered','returned','return_requested','returning'].includes(order.status)) { %>
                                <% if (order.status !== 'pending') { %>
                                    <button onclick="updateStatus('<%= order._id %>', '<%= order.status %>')" class="btn btn-sm btn-secondary">Update</button>
                                <% } %>
                                <button onclick="cancelOrder('<%= order._id %>')" class="btn btn-sm btn-danger">Cancel</button>
                            <% } %>
                        </div>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<!-- Rejection Modal -->
<div style="display:none; position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.4);align-items:center;justify-content:center;" id="rejectModal">
    <div style="background:#fff;border-radius:12px;padding:28px;width:460px;max-width:95vw;box-shadow:0 20px 40px rgba(0,0,0,0.2);">
        <h3 style="margin-bottom:20px;font-size:17px;">Reject Return Request</h3>
        <div class="form-group">
            <label class="form-label">Rejection Category</label>
            <select class="form-select" id="rejectionCategory">
                <option value="">Select a category</option>
                <option>Invalid reason</option>
                <option>Outside return window</option>
                <option>Product condition</option>
                <option>Policy violation</option>
                <option>Other</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Detailed Explanation</label>
            <textarea class="form-control" id="rejectionReason" rows="3" placeholder="Provide a detailed explanation..."></textarea>
        </div>
        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:20px;">
            <button class="btn btn-secondary" onclick="document.getElementById('rejectModal').style.display='none'">Cancel</button>
            <button class="btn btn-danger" onclick="submitRejection()">Submit Rejection</button>
        </div>
    </div>
</div>

<script>
let currentOrderId = null;

async function updateStatus(orderId, currentStatus) {
    const statuses = ['pending','confirmed','shipped','delivered'];
    const idx = statuses.indexOf(currentStatus);
    const opts = {};
    statuses.forEach((s, i) => { if (i >= idx) opts[s] = s.charAt(0).toUpperCase() + s.slice(1); });
    const { value: status } = await Swal.fire({ title: 'Update Status', input: 'select', inputOptions: opts, inputPlaceholder: 'Select status', showCancelButton: true, confirmButtonColor: '#6366f1', inputValidator: v => !v ? 'Select a status!' : null });
    if (status) {
        const data = await (await fetch('/admin/orders/update-status', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({orderId, status}) })).json();
        if (data.success) { Swal.fire({icon:'success',title:'Updated',timer:1500,showConfirmButton:false}).then(()=>location.reload()); }
        else Swal.fire('Error', data.message || 'Failed', 'error');
    }
}

async function cancelOrder(orderId) {
    const result = await Swal.fire({ title:'Cancel Order?', text:'This cannot be undone.', icon:'warning', showCancelButton:true, confirmButtonColor:'#ef4444', confirmButtonText:'Yes, cancel' });
    if (result.isConfirmed) {
        const data = await (await fetch('/admin/orders/cancel', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({orderId}) })).json();
        if (data.success) { Swal.fire({icon:'success',timer:1500,showConfirmButton:false}).then(()=>location.reload()); }
        else Swal.fire('Error', data.message || 'Failed', 'error');
    }
}

async function handleReturn(action, orderId) {
    currentOrderId = orderId;
    if (action === 'reject') { document.getElementById('rejectModal').style.display = 'flex'; return; }
    const result = await Swal.fire({ title:'Approve Return?', icon:'warning', showCancelButton:true, confirmButtonColor:'#6366f1', confirmButtonText:'Yes, approve' });
    if (result.isConfirmed) {
        const data = await (await fetch('/admin/orders/handle-return', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({orderId, action}) })).json();
        if (data.success) Swal.fire('Approved!', '', 'success').then(()=>location.reload());
        else Swal.fire('Error', data.message, 'error');
    }
}

async function submitRejection() {
    const category = document.getElementById('rejectionCategory').value;
    const reason = document.getElementById('rejectionReason').value;
    if (!category || !reason) { Swal.fire('Required', 'Please fill all fields.', 'warning'); return; }
    const data = await (await fetch('/admin/orders/handle-return', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({orderId:currentOrderId, action:'reject', category, message:reason}) })).json();
    document.getElementById('rejectModal').style.display = 'none';
    if (data.success) Swal.fire('Rejected!', '', 'success').then(()=>location.reload());
    else Swal.fire('Error', data.message, 'error');
}

async function updateReturnStatus(orderId) {
    const { value: status } = await Swal.fire({ title:'Update Return Status', input:'select', inputOptions:{returning:'Returning',returned:'Returned'}, showCancelButton:true, confirmButtonColor:'#6366f1', inputValidator: v => !v ? 'Select!' : null });
    if (status) {
        const data = await (await fetch('/admin/orders/update-return-status', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({orderId,status}) })).json();
        if (data.success) Swal.fire({icon:'success',timer:1500,showConfirmButton:false}).then(()=>location.reload());
        else Swal.fire('Error', data.message, 'error');
    }
}
</script>

<%- include('../partials/admin/footer') %>