<%- include("../../views/partials/admin/header") %>

<style>
.page-hero {
    background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
    border-radius: 16px; padding: 28px 32px; color: #fff;
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 24px; position: relative; overflow: hidden;
}
.page-hero::before { content:''; position:absolute; top:-60px; right:-60px; width:200px; height:200px; background:rgba(99,102,241,0.15); border-radius:50%; }
.page-hero h1 { font-size: 24px; font-weight: 700; margin-bottom: 4px; }
.page-hero p { color: rgba(255,255,255,0.6); font-size: 13px; }
.hero-stat { background:rgba(255,255,255,0.08); border-radius:10px; padding:14px 22px; text-align:center; }
.hero-stat .val { font-size:28px; font-weight:700; }
.hero-stat .lbl { font-size:11px; color:rgba(255,255,255,0.6); margin-top:2px; }

.layout-grid { display: grid; grid-template-columns: 340px 1fr; gap: 20px; }
@media(max-width:900px) { .layout-grid { grid-template-columns: 1fr; } }

.form-card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; align-self: start; }
.form-card-header { background: linear-gradient(135deg, #6366f1, #8b5cf6); padding: 18px 22px; color: #fff; }
.form-card-header h3 { font-size: 15px; font-weight: 600; margin-bottom: 4px; }
.form-card-header p { font-size: 12px; opacity: 0.8; }
.form-card-body { padding: 22px; }

.table-card { background:var(--surface); border:1px solid var(--border); border-radius:14px; overflow:hidden; }
.table-card-header { padding:16px 20px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; }
.table-card-header h3 { font-size:15px; font-weight:600; }

.search-bar-row { padding: 14px 20px; border-bottom: 1px solid var(--border); background: #fafbff; }
.search-bar-row form { display:flex; gap:10px; flex-wrap:wrap; }

.cat-name { font-weight: 600; font-size: 13.5px; }
.cat-desc { font-size: 12px; color: var(--text-muted); max-width: 180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

.offer-pill { display:inline-flex; align-items:center; gap:4px; background:#dcfce7; color:#16a34a; padding:3px 10px; border-radius:20px; font-size:12px; font-weight:700; }

.inline-actions { display:flex; gap:6px; flex-wrap:wrap; }
.ia-btn { display:inline-flex; align-items:center; gap:4px; padding:5px 11px; border-radius:7px; font-size:12px; font-weight:600; cursor:pointer; border:none; transition:all 0.15s; }
.ia-edit { background:#ede9fe; color:#7c3aed; }
.ia-edit:hover { background:#ddd6fe; }
.ia-list { background:#dcfce7; color:#16a34a; }
.ia-list:hover { background:#bbf7d0; }
.ia-unlist { background:#fef9c3; color:#a16207; }
.ia-unlist:hover { background:#fef08a; }
.ia-delete { background:#fee2e2; color:#dc2626; }
.ia-delete:hover { background:#fecaca; }

.form-field { margin-bottom: 16px; }
.form-field label { display:block; font-size:12px; font-weight:600; color:var(--text-secondary); margin-bottom:6px; text-transform:uppercase; letter-spacing:0.04em; }
.form-field input, .form-field textarea { width:100%; padding:10px 13px; border:1.5px solid var(--border); border-radius:9px; font-size:14px; font-family:'Inter',sans-serif; color:var(--text-primary); background:var(--surface); transition:all 0.2s; outline:none; }
.form-field input:focus, .form-field textarea:focus { border-color:#6366f1; box-shadow:0 0 0 3px rgba(99,102,241,0.1); }
.submit-btn { width:100%; padding:12px; background:linear-gradient(135deg,#6366f1,#8b5cf6); color:#fff; border:none; border-radius:9px; font-size:14px; font-weight:600; cursor:pointer; transition:all 0.2s; font-family:'Inter',sans-serif; display:flex; align-items:center; justify-content:center; gap:8px; }
.submit-btn:hover { opacity: 0.92; transform: translateY(-1px); }

.table-footer { padding:14px 20px; border-top:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; }
</style>

<!-- Hero -->
<div class="page-hero">
    <div>
        <h1>Categories</h1>
        <p>Organize products into categories and manage offers</p>
    </div>
    <div class="hero-stat">
        <div class="val"><%= categories.length %></div>
        <div class="lbl">Total Categories</div>
    </div>
</div>

<div class="layout-grid">
    <!-- Add Category Form -->
    <div class="form-card">
        <div class="form-card-header">
            <h3><i class="fas fa-plus-circle" style="margin-right:6px;"></i>Add New Category</h3>
            <p>Fill the form to create a new product category</p>
        </div>
        <div class="form-card-body">
            <form id="addCategoryForm">
                <div class="form-field">
                    <label>Category Name</label>
                    <input type="text" name="name" id="category_name" placeholder="e.g. Gaming Laptops" required>
                </div>
                <div class="form-field">
                    <label>Description</label>
                    <textarea name="description" id="category_description" rows="4" placeholder="Brief description of this category..." required></textarea>
                </div>
                <button type="submit" class="submit-btn">
                    <i class="fas fa-plus"></i> Create Category
                </button>
            </form>
        </div>
    </div>

    <!-- Category List -->
    <div>
        <div class="table-card">
            <div class="table-card-header">
                <h3><i class="fas fa-tags" style="color:#6366f1;margin-right:8px;"></i>Category List</h3>
            </div>
            <div class="search-bar-row">
                <form action="/admin/category/" method="get">
                    <input type="text" class="form-control" placeholder="Search categories..." name="search" style="max-width:260px;">
                    <input type="number" class="form-control" placeholder="Min %" name="minOffer" min="0" max="99" style="max-width:100px;">
                    <input type="number" class="form-control" placeholder="Max %" name="maxOffer" min="0" max="99" style="max-width:100px;">
                    <button class="btn btn-primary" type="submit"><i class="fas fa-search"></i> Search</button>
                </form>
            </div>
            <div class="table-responsive">
                <table class="data-table" style="min-width:680px;">
                    <thead>
                        <tr>
                            <th style="padding-left:20px;">Category</th>
                            <th>Offer</th>
                            <th>Status</th>
                            <th style="text-align:right;padding-right:20px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% categories.forEach((category) => { %>
                        <tr>
                            <td style="padding-left:20px;">
                                <div class="cat-name"><%= category.name %></div>
                                <div class="cat-desc"><%= category.description %></div>
                            </td>
                            <td>
                                <% if (category.categoryOffer === 0) { %>
                                    <button class="ia-btn ia-edit" onclick="addOffer('<%= category._id %>')">
                                        <i class="fas fa-tag"></i> Add Offer
                                    </button>
                                <% } else { %>
                                    <div style="margin-bottom:6px;">
                                        <span class="offer-pill"><i class="fas fa-bolt" style="font-size:10px;"></i><%= category.categoryOffer %>% OFF</span>
                                    </div>
                                    <div style="display:flex;gap:4px;">
                                        <button class="ia-btn ia-edit" onclick="editOffer('<%= category._id %>', '<%= category.categoryOffer %>')">Edit</button>
                                        <button class="ia-btn ia-delete" onclick="deleteOffer('<%= category._id %>')">Remove</button>
                                    </div>
                                <% } %>
                            </td>
                            <td>
                                <% if (category.isListed) { %>
                                    <span style="display:inline-flex;align-items:center;background:#dcfce7;color:#16a34a;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:600;"><span style="width:6px;height:6px;border-radius:50%;background:#22c55e;margin-right:5px;display:inline-block;"></span>Listed</span>
                                <% } else { %>
                                    <span style="display:inline-flex;align-items:center;background:#fee2e2;color:#dc2626;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:600;"><span style="width:6px;height:6px;border-radius:50%;background:#ef4444;margin-right:5px;display:inline-block;"></span>Unlisted</span>
                                <% } %>
                            </td>
                            <td style="padding-right:20px;">
                                <div class="inline-actions" style="justify-content:flex-end;">
                                    <button class="ia-btn ia-edit" onclick="editCategory('<%= category._id %>', '<%= category.name %>', '<%= category.description %>')">
                                        <i class="fas fa-pencil-alt"></i>
                                    </button>
                                    <% if (category.isListed) { %>
                                        <button class="ia-btn ia-unlist" onclick="unlistCategory('<%= category._id %>')">Unlist</button>
                                    <% } else { %>
                                        <button class="ia-btn ia-list" onclick="listCategory('<%= category._id %>')">List</button>
                                    <% } %>
                                    <button class="ia-btn ia-delete" onclick="deleteCategory('<%= category._id %>')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                        <% if(categories.length === 0) { %>
                        <tr><td colspan="4" style="text-align:center;padding:40px;color:var(--text-muted);"><i class="fas fa-tags" style="font-size:28px;display:block;margin-bottom:10px;opacity:0.3;"></i>No categories found</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <div class="table-footer">
                <span style="font-size:13px;color:var(--text-muted);"><%= categories.length %> categories</span>
                <nav>
                    <ul class="pagination" style="margin:0;padding:0;">
                        <% if (currentPage > 1) { %><li class="page-item"><a class="page-link" href="?page=<%= currentPage - 1 %>">‹</a></li><% } %>
                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <li class="page-item <%= i === currentPage ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %>"><%= i %></a></li>
                        <% } %>
                        <% if (currentPage < totalPages) { %><li class="page-item"><a class="page-link" href="?page=<%= currentPage + 1 %>">›</a></li><% } %>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('addCategoryForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    fetch('/admin/addCategory', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(Object.fromEntries(formData)) })
    .then(r => r.json()).then(data => {
        if (data.success) Swal.fire({icon:'success',title:'Category Created!',text:data.message,confirmButtonColor:'#6366f1'}).then(()=>location.reload());
        else Swal.fire({icon:'error',title:'Error',text:data.message,confirmButtonColor:'#6366f1'});
    });
});

function editCategory(id, name, description) {
    Swal.fire({ title:'Edit Category', html:`<input id="swal-input1" class="swal2-input" value="${name}" placeholder="Category Name"><textarea id="swal-input2" class="swal2-textarea" placeholder="Description">${description}</textarea>`, focusConfirm:false, confirmButtonColor:'#6366f1', preConfirm: () => ({ name: document.getElementById('swal-input1').value, description: document.getElementById('swal-input2').value }) })
    .then(result => { if (result.isConfirmed) fetch(`/admin/editCategory/${id}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(result.value)}).then(r=>r.json()).then(d=>{if(d.success)Swal.fire({icon:'success',timer:1500,showConfirmButton:false}).then(()=>location.reload());else Swal.fire('Error',d.message,'error');}); });
}
function unlistCategory(id) { Swal.fire({title:'Unlist Category?',icon:'warning',showCancelButton:true,confirmButtonColor:'#6366f1'}).then(r=>{if(r.isConfirmed)fetch(`/admin/listCategory?id=${id}`).then(r=>r.json()).then(d=>{if(d.success)location.reload();else Swal.fire('Error',d.message,'error');})}); }
function listCategory(id) { Swal.fire({title:'List Category?',icon:'info',showCancelButton:true,confirmButtonColor:'#6366f1'}).then(r=>{if(r.isConfirmed)fetch(`/admin/unListCategory?id=${id}`).then(r=>r.json()).then(d=>{if(d.success)location.reload();else Swal.fire('Error',d.message,'error');})}); }
function addOffer(categoryId) { Swal.fire({title:'Set Category Offer',input:'number',inputLabel:'Offer Percentage (1-99)',inputAttributes:{min:1,max:99,step:1},showCancelButton:true,confirmButtonColor:'#6366f1',showLoaderOnConfirm:true,preConfirm:pct=>fetch('/admin/addCategoryOffer',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({categoryId,percentage:parseInt(pct)})}).then(r=>r.json()).then(d=>{if(!d.status)throw new Error(d.message);return d;}).catch(e=>Swal.showValidationMessage(`Failed: ${e}`)),allowOutsideClick:()=>!Swal.isLoading()}).then(r=>{if(r.isConfirmed)Swal.fire({icon:'success',timer:1500,showConfirmButton:false}).then(()=>location.reload())}); }
function editOffer(categoryId, currentOffer) { Swal.fire({title:'Edit Category Offer',input:'number',inputValue:currentOffer,inputAttributes:{min:1,max:99,step:1},showCancelButton:true,confirmButtonColor:'#6366f1',showLoaderOnConfirm:true,preConfirm:pct=>fetch('/admin/editCategoryOffer',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({categoryId,percentage:parseInt(pct)})}).then(r=>r.json()).then(d=>{if(!d.status)throw new Error(d.message);return d;}).catch(e=>Swal.showValidationMessage(`Failed: ${e}`)),allowOutsideClick:()=>!Swal.isLoading()}).then(r=>{if(r.isConfirmed)Swal.fire({icon:'success',timer:1500,showConfirmButton:false}).then(()=>location.reload())}); }
function deleteOffer(categoryId) { Swal.fire({title:'Remove Offer?',icon:'warning',showCancelButton:true,confirmButtonColor:'#ef4444'}).then(r=>{if(r.isConfirmed)fetch('/admin/removeCategoryOffer',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({categoryId})}).then(r=>r.json()).then(d=>{if(d.status)Swal.fire({icon:'success',timer:1500,showConfirmButton:false}).then(()=>location.reload());else Swal.fire('Error',d.message,'error');})}); }
function deleteCategory(categoryId) { Swal.fire({title:'Delete Category?',text:"This cannot be undone.",icon:'warning',showCancelButton:true,confirmButtonColor:'#ef4444'}).then(r=>{if(r.isConfirmed)fetch(`/admin/deleteCategory/${categoryId}`,{method:'DELETE'}).then(r=>r.json()).then(d=>{if(d.success)Swal.fire({icon:'success',timer:1500,showConfirmButton:false}).then(()=>location.reload());else Swal.fire('Error',d.message,'error');})}); }
</script>

<%- include("../../views/partials/admin/footer") %>
